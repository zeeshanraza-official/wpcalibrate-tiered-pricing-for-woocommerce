{
    "name": "wpcalibrate/wpcalibrate-tiered-pricing-for-woocommerce",
    "description": "Server-authoritative quantity-based tiered pricing rules for WooCommerce products, variations, categories, and global cart items.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "WPCalibrate",
            "email": "support@wpcalibrate.com",
            "homepage": "https://wpcalibrate.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "WPCalibrate\\TieredPricing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPCalibrate\\TieredPricing\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
